{
  "name": "@awesome/interactions",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css.ts",
    "**/*.css"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./motion": {
      "source": "./src/motion/motion-provider.tsx",
      "types": "./dist/types/motion/motion-provider.d.ts",
      "default": "./dist/motion.js"
    },
    "./style.css": "./dist/style.css",
    "./registry": "./src/registry.ts",
    "./sources": "./src/sources.ts",
    "./demo/*": "./src/*/demo.tsx"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@awesome/theme": "workspace:*",
    "@vanilla-extract/css": "catalog:",
    "@vanilla-extract/dynamic": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vanilla-extract/vite-plugin": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "motion": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "motion": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
