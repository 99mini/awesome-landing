{
  "name": "awesome-landing",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @awesome/gallery dev",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck",
    "new:landing": "node scripts/new-landing.mjs",
    "skills:install": "npx -y skills experimental_install --agent claude-code",
    "audit:design": "node scripts/hallmark-audit.mjs",
    "test:e2e": "pnpm --filter @awesome/e2e test",
    "stories:gen": "node scripts/gen-stories.mjs",
    "storybook": "pnpm --filter @awesome/storybook storybook",
    "test:stories": "pnpm --filter @awesome/storybook test",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:package": "node scripts/check-package.mjs",
    "test:visual": "pnpm --filter @awesome/e2e test:visual",
    "vendor:interactions": "node scripts/vendor.mjs"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.22.0"
}
