{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "unicorn/filename-case": [
      "error",
      {
        "case": "kebabCase"
      }
    ],
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/no-array-index-key": "off",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css", "**/*.css.ts", "@awesome/theme/reset"]
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "motion/react",
            "importNames": ["motion"],
            "message": "m \uc744 \uc4f4\ub2e4 \u2014 \uc560\ub2c8\uba54\uc774\uc158 \uae30\ub2a5\uc740 MotionProvider(LazyMotion)\uac00 \ub098\uc911\uc5d0 \ubc1b\ub294\ub2e4. \uccab \ub85c\ub4dc\uc5d0 Motion \uc804\uccb4\uac00 \ub4e4\uc5b4\uac00\uc9c0 \uc54a\uac8c."
          }
        ]
      }
    ]
  },
  "env": {
    "builtin": true,
    "browser": true
  },
  "ignorePatterns": ["**/dist/**", "templates/**", ".claude/**", ".hallmark/**"],
  "overrides": [
    {
      "files": ["e2e/**"],
      "rules": {
        "no-await-in-loop": "off"
      }
    }
  ]
}
